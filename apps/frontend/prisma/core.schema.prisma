generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma-core"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  name                String
  avatarUrl           String?
  bannerUrl           String?
  profileQuote        String?
  email               String   @unique
  passwordHash        String?
  googleId            String?  @unique
  age                 Int?
  weight              Float?
  targetWeight        Float?
  height              Float?
  registeredAt        DateTime @default(now())
  onboardingCompleted Boolean  @default(false)

  challenges   Challenge[]
  sideQuests   SideQuest[]
  achievements Achievement[]
}

model Challenge {
  id                       String   @id @default(uuid())
  userId                   String
  isActive                 Boolean  @default(true)
  difficulty               String
  startDate                DateTime @default(now())
  currentDay               Int      @default(1)
  streak                   Int      @default(0)
  points                   Int      @default(0)
  bestWeight               Float?
  challengesCompleted      Int      @default(0)
  breakStreakOnPeriodFail  Boolean  @default(false)

  user                User                 @relation(fields: [userId], references: [id])
  customGoalsTemplate GoalTemplate[]
  dailyLogs           DailyLog[]
  periodGoals         PeriodGoalProgress[]
}

model GoalTemplate {
  id              String  @id @default(uuid())
  challengeId     String
  title           String
  description     String?
  icon            String?
  cadence         String  @default("daily") // daily, weekly, monthly
  measurementType String  @default("boolean") // boolean, count, numeric
  targetValue     Float   @default(1)
  targetUnit      String?
  order           Int     @default(0)
  isActive        Boolean @default(true)

  challenge      Challenge            @relation(fields: [challengeId], references: [id])
  periodProgress PeriodGoalProgress[]
}

model DailyLog {
  id          String  @id @default(uuid())
  challengeId String
  date        String // YYYY-MM-DD format
  weight      Float?
  photoUrl    String?
  notes       String?
  status      String  @default("pending") // pending, success, fail, rest

  challenge Challenge   @relation(fields: [challengeId], references: [id])
  goals     DailyGoal[]

  @@unique([challengeId, date])
}

model DailyGoal {
  id              String  @id @default(uuid())
  dailyLogId      String
  templateId      String?
  title           String
  description     String?
  icon            String?
  measurementType String  @default("boolean") // boolean, count, numeric
  targetValue     Float   @default(1)
  targetUnit      String?
  currentValue    Float   @default(0)
  completed       Boolean @default(false)

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id])
}

model PeriodGoalProgress {
  id              String   @id @default(uuid())
  challengeId     String
  templateId      String?
  title           String
  description     String?
  icon            String?
  cadence         String   // weekly, monthly
  measurementType String   @default("count") // boolean, count, numeric
  targetValue     Float    @default(1)
  targetUnit      String?
  currentValue    Float    @default(0)
  periodNumber    Int
  periodKey       String   // W01..W11, M01..M03
  startDate       String   // YYYY-MM-DD
  endDate         String   // YYYY-MM-DD
  status          String   @default("pending") // pending, success, fail
  updatedAt       DateTime @updatedAt

  challenge Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  template  GoalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([challengeId, periodKey, templateId])
  @@index([challengeId, cadence, periodNumber])
}

model SideQuest {
  id              String   @id @default(uuid())
  userId          String
  templateId      String?
  title           String
  description     String?
  difficulty      String
  durationDays    Int
  icon            String?
  startedAt       DateTime @default(now())
  progress        Int      @default(0)
  completed       Boolean  @default(false)
  completionCount Int      @default(0)

  user     User               @relation(fields: [userId], references: [id])
  template SideQuestTemplate? @relation(fields: [templateId], references: [id])
  runs     SideQuestRun[]
}

model SideQuestTemplate {
  id           String  @id @default(uuid())
  title        String  @unique
  description  String?
  difficulty   String
  durationDays Int
  icon         String?

  quests SideQuest[]
  tasks  SideQuestTaskTemplate[]
}

model SideQuestTaskTemplate {
  id              String  @id @default(uuid())
  templateId      String
  title           String
  description     String?
  icon            String?
  order           Int     @default(0)
  frequency       String  @default("daily") // daily, weekly, monthly, once
  measurementType String  @default("boolean") // boolean, count, numeric
  targetValue     Float?
  targetUnit      String?

  template SideQuestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks    SideQuestTask[]
}

model SideQuestRun {
  id          String    @id @default(uuid())
  sideQuestId String
  runNumber   Int
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  completed   Boolean   @default(false)

  sideQuest SideQuest       @relation(fields: [sideQuestId], references: [id], onDelete: Cascade)
  tasks     SideQuestTask[]

  @@unique([sideQuestId, runNumber])
  @@index([sideQuestId, completed])
}

model SideQuestTask {
  id              String    @id @default(uuid())
  runId           String
  templateTaskId  String?
  title           String
  description     String?
  icon            String?
  order           Int       @default(0)
  frequency       String    @default("daily") // daily, weekly, monthly, once
  measurementType String    @default("boolean") // boolean, count, numeric
  targetValue     Float?
  targetUnit      String?
  completed       Boolean   @default(false)
  completedAt     DateTime?

  run          SideQuestRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  templateTask SideQuestTaskTemplate? @relation(fields: [templateTaskId], references: [id], onDelete: SetNull)
  logs         SideQuestTaskLog[]

  @@index([runId, order])
}

model SideQuestTaskLog {
  id          String   @id @default(uuid())
  taskId      String
  periodKey   String
  value       Float    @default(1)
  completedAt DateTime @default(now())

  task SideQuestTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, periodKey])
  @@index([taskId])
}

model Achievement {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String
  icon        String
  color       String
  unlocked    Boolean   @default(false)
  unlockedAt  DateTime?
  progress    Int       @default(0)
  total       Int

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, title])
}

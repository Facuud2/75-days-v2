generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma-health"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("HEALTH_DATABASE_URL")
}

model UserHealthProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  dailyCalorieGoal Int      @default(2000)
  proteinGoalG     Float    @default(150)
  carbGoalG        Float    @default(200)
  fatGoalG         Float    @default(65)
  weightKg         Float    @default(70)
  heightCm         Float    @default(170)

  // Strava Integration
  stravaAccessToken    String?
  stravaRefreshToken   String?
  stravaTokenExpiresAt Int?
  stravaAthleteId      String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model MealEntry {
  id            String   @id @default(uuid())
  userId        String
  date          String // YYYY-MM-DD
  mealType      String // breakfast | lunch | dinner | snack
  name          String
  calories      Float
  proteinG      Float    @default(0)
  carbG         Float    @default(0)
  fatG          Float    @default(0)
  fiberG        Float    @default(0)
  sugarG        Float    @default(0)
  photoUrl      String?
  routineItemId String?
  createdAt     DateTime @default(now())

  @@index([userId, date])
}

model MealRoutine {
  id          String            @id @default(uuid())
  userId      String
  name        String
  description String?
  mode        String            @default("weekly") // daily | weekly
  goalTag     String?           // high_protein | deficit | maintenance | lean_bulk | custom
  isActive    Boolean           @default(false)
  items       MealRoutineItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([userId, isActive])
}

model MealRoutineItem {
  id           String      @id @default(uuid())
  routineId    String
  dayOfWeek    Int?        // null when mode == "daily"; 0 (Mon) .. 6 (Sun) when mode == "weekly"
  mealType     String      // breakfast | lunch | dinner | snack
  name         String
  calories     Float
  proteinG     Float       @default(0)
  carbG        Float       @default(0)
  fatG         Float       @default(0)
  fiberG       Float       @default(0)
  sugarG       Float       @default(0)
  prepTimeMin  Int?        @default(5)
  customFoodId String?
  notes        String?
  order        Int         @default(0)

  routine MealRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@index([routineId, dayOfWeek])
}

model WorkoutEntry {
  id               String   @id @default(uuid())
  userId           String
  date             String // YYYY-MM-DD
  title            String? // Optional workout title e.g. "Empuje A"
  sport            String // strength | running | cycling | yoga | swimming | walking | other
  durationMin      Int
  intensity        String // low | medium | high
  caloriesBurned   Float
  isManualCalories Boolean  @default(false)
  distanceKm       Float?
  loadVolumeKg     Float?
  notes            String?
  routineId        String?
  environment      String?  // home | gym | outdoor
  linkedGoalId     String?  // Optional DailyGoal ID override in Core DB

  // External Integration
  source     String  @default("manual") // manual | tracker | strava
  externalId String? @unique

  exercises WorkoutExercise[]

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WorkoutExercise {
  id            String       @id @default(uuid())
  workoutId     String
  exerciseId    String
  exerciseName  String
  primaryMuscle String?
  equipment     String?
  order         Int          @default(0)
  notes         String?

  workout WorkoutEntry @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sets    WorkoutSet[]

  @@index([workoutId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String          @id @default(uuid())
  workoutExerciseId String
  setNumber         Int
  setType           String          @default("normal") // warmup | normal | dropset | failure
  weightKg          Float?
  reps              Int?
  durationSec       Int?
  distanceM         Float?
  rpe               Float?
  completed         Boolean         @default(true)

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
}

model WorkoutRoutine {
  id          String            @id @default(uuid())
  userId      String
  name        String
  description String?
  sport       String            @default("strength")
  exercises   RoutineExercise[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
}

model RoutineExercise {
  id             String         @id @default(uuid())
  routineId      String
  exerciseId     String
  exerciseName   String
  primaryMuscle  String?
  equipment      String?
  order          Int            @default(0)
  targetSets     Int            @default(3)
  targetReps     String?
  defaultRestSec Int            @default(90)

  routine WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId])
}

model TrainingPlan {
  id           String             @id @default(uuid())
  userId       String
  challengeId  String?
  name         String
  goalSummary  String?
  scheduleType String             @default("weekly") // daily | weekly | sequential
  environment  String             @default("mixed") // home | gym | outdoor | mixed
  isActive     Boolean            @default(false)
  slots        TrainingPlanSlot[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId])
  @@index([userId, isActive])
}

model TrainingPlanSlot {
  id                String   @id @default(uuid())
  planId            String
  dayOfWeek         Int? // null when daily/sequential; 0 (Mon) .. 6 (Sun) when weekly
  timeOfDay         String   @default("any") // morning | afternoon | evening | any
  order             Int      @default(0)
  slotType          String   @default("routine") // routine | focus | cardio | rest
  title             String
  focusMuscles      String[] @default([])
  environment       String? // home | gym | outdoor
  sport             String   @default("strength")
  targetDurationMin Int?
  targetSteps       Int?
  routineId         String?
  notes             String?
  exercisesJson     Json?

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([planId, dayOfWeek])
}

model CustomExercise {
  id            String   @id @default(uuid())
  userId        String
  name          String
  bodyZone      String   @default("chest")
  primaryMuscle String
  equipment     String   @default("body only")
  category      String   @default("strength")
  metValue      Float    @default(5.0)
  notes         String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Ingredient {
  id              String @id @default(uuid())
  name            String @unique
  caloriesPer100g Float
  proteinPer100g  Float
  carbPer100g     Float
  fatPer100g      Float

  customFoodIngredients CustomFoodIngredient[]
}

model CustomFood {
  id          String  @id @default(uuid())
  userId      String
  name        String
  description String?

  calories Float @default(0)
  proteinG Float @default(0)
  carbG    Float @default(0)
  fatG     Float @default(0)

  servingSize String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients CustomFoodIngredient[]

  @@index([userId])
}

model CustomFoodIngredient {
  id           String @id @default(uuid())
  customFoodId String
  ingredientId String
  weightGrams  Float

  customFood CustomFood @relation(fields: [customFoodId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([customFoodId])
  @@index([ingredientId])
}

{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "clean": "next clean",
    "db:generate": "prisma generate --schema=prisma/core.schema.prisma && prisma generate --schema=prisma/health.schema.prisma",
    "postinstall": "npm run db:generate",
    "e2e": "playwright test",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^3.6.0",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.2.1",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.23.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "prisma": "^6.19.3",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",

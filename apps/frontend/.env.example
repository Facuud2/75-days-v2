# URLs de los backends (requeridas)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_HEALTH_API_URL="http://localhost:3002/api"

# Producción en Vercel:
# NEXT_PUBLIC_API_URL="https://seven5-days-v2.onrender.com/api"
# NEXT_PUBLIC_HEALTH_API_URL="https://seven5-days-v2-1.onrender.com/api"

# Google OAuth 2.0 Client ID (Google Identity Services Popup)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"

# Gemini no forma parte del producto. No configurar ninguna API key de Gemini.

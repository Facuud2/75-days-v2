# URLs de la API (opcional en Vercel/local same-origin: por defecto usa "/api")
# Mantener solo si se quiere apuntar temporalmente a los microservicios externos en Render/local
# NEXT_PUBLIC_API_URL="http://localhost:3001/api"
# NEXT_PUBLIC_HEALTH_API_URL="http://localhost:3002/api"

# Base de datos Neon Postgres (Serverless Driver + Prisma Adapter)
# Usar el endpoint pooled (-pooler) para tráfico de funciones en Vercel:
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/75days?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/75days?sslmode=require"

# Base de datos de Salud (si se omite, se deriva automáticamente de DATABASE_URL apuntando a /75days_health)
HEALTH_DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/75days_health?sslmode=require"

# Autenticación JWT
JWT_SECRET="your_jwt_secret_here_change_me_in_prod"

# Google OAuth 2.0 Client ID (Google Identity Services Popup + validación en servidor)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"

# Gemini AI (Generación y edición dinámica de planes en lenguaje natural / audio)
GEMINI_API_KEY="your_gemini_api_key_here"

# Upstash Redis (Rate limiting distribuido para /api/auth/* y /api/ai/* en Vercel)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Integraciones externas de salud (opcionales — dejar vacías si aún no están conectadas)
FATSECRET_CLIENT_ID=""
FATSECRET_CLIENT_SECRET=""
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3000/api/strava/callback"

# Microservicio independiente de Catálogo de Ejercicios (Cloudflare Workers + R2)
# En local: "http://127.0.0.1:8787" | En preview/prod: "https://seventyfive-days-exercise-api.<tu-subdominio>.workers.dev"
# Si se deja vacío, la app usa el bundle estático "/data/exercises.es.json" con 0 llamadas a Vercel Functions.
NEXT_PUBLIC_EXERCISE_API_URL=""

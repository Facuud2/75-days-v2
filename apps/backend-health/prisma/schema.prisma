generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Stores per-user caloric and macronutrient goals
model UserHealthProfile {
  id               String   @id @default(uuid())
  userId           String   @unique  // references User.id in backend-core (no FK)
  dailyCalorieGoal Int      @default(2000)
  proteinGoalG     Float    @default(150)
  carbGoalG        Float    @default(200)
  fatGoalG         Float    @default(65)
  // User weight used for calorie-burn estimation (synced manually or via onboarding)
  weightKg         Float    @default(70)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

// Logs food intake per meal slot
model MealEntry {
  id        String   @id @default(uuid())
  userId    String
  date      String   // YYYY-MM-DD
  mealType  String   // breakfast | lunch | dinner | snack
  name      String
  calories  Float
  proteinG  Float    @default(0)
  carbG     Float    @default(0)
  fatG      Float    @default(0)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Logs physical activity sessions
model WorkoutEntry {
  id               String   @id @default(uuid())
  userId           String
  date             String   // YYYY-MM-DD
  sport            String   // strength | running | cycling | yoga | swimming | other
  durationMin      Int
  intensity        String   // low | medium | high
  caloriesBurned   Float    // auto-calculated or manual override
  isManualCalories Boolean  @default(false)
  distanceKm       Float?   // optional — for cardio
  loadVolumeKg     Float?   // optional — for strength (sets × reps × weight)
  notes            String?
  createdAt        DateTime @default(now())

  @@index([userId, date])
}

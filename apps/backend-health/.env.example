# Health Microservice — Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3002

# Database (separate DB from backend-core)
DATABASE_URL="postgresql://user:password@localhost:5432/75days_health"

# JWT (must match backend-core's JWT_SECRET so tokens are interoperable)
JWT_SECRET=your_jwt_secret_here_change_me_in_prod

# Internal API Key — shared secret between backend-core and backend-health
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change_me_to_a_long_random_secret

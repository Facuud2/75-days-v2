# backend-core — Environment Variables
# Copy this file to .env and fill in the values

NODE_ENV=development
PORT=3001

# Database (own DB, separate from backend-health)
DATABASE_URL="postgresql://user:password@localhost:5432/75days"

# JWT (must match backend-health's JWT_SECRET so tokens are interoperable)
JWT_SECRET=your_jwt_secret_here_change_me_in_prod

# Internal API Key — shared secret between backend-core and backend-health
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change_me_to_a_long_random_secret

# backend-health base URL
HEALTH_SERVICE_URL=http://localhost:3002

# Frontend URL (CORS / generated links)
FRONTEND_URL=http://localhost:3000

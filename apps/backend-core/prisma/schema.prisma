generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  name                String
  avatarUrl           String?
  bannerUrl           String?
  profileQuote        String?
  email               String   @unique
  passwordHash        String?
  googleId            String?  @unique
  age                 Int?
  weight              Float?
  targetWeight        Float?
  height              Float?
  registeredAt        DateTime @default(now())
  onboardingCompleted Boolean  @default(false)

  challenges   Challenge[]
  sideQuests   SideQuest[]
  achievements Achievement[]
}

model Challenge {
  id                  String   @id @default(uuid())
  userId              String
  isActive            Boolean  @default(true)
  difficulty          String
  startDate           DateTime @default(now())
  currentDay          Int      @default(1)
  streak              Int      @default(0)
  points              Int      @default(0)
  bestWeight          Float?
  challengesCompleted Int      @default(0)

  user                User           @relation(fields: [userId], references: [id])
  customGoalsTemplate GoalTemplate[]
  dailyLogs           DailyLog[]
}

model GoalTemplate {
  id          String  @id @default(uuid())
  challengeId String
  title       String
  description String?
  icon        String?

  challenge Challenge @relation(fields: [challengeId], references: [id])
}

model DailyLog {
  id          String  @id @default(uuid())
  challengeId String
  date        String // YYYY-MM-DD format
  weight      Float?
  photoUrl    String?
  notes       String?
  status      String  @default("pending") // pending, success, fail, rest

  challenge Challenge   @relation(fields: [challengeId], references: [id])
  goals     DailyGoal[]

  @@unique([challengeId, date])
}

model DailyGoal {
  id          String  @id @default(uuid())
  dailyLogId  String
  title       String
  description String?
  icon        String?
  completed   Boolean @default(false)

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id])
}

model SideQuest {
  id              String   @id @default(uuid())
  userId          String
  templateId      String?
  title           String
  description     String?
  difficulty      String
  durationDays    Int
  icon            String?
  startedAt       DateTime @default(now())
  progress        Int      @default(0)
  completed       Boolean  @default(false)
  completionCount Int      @default(0)

  user     User             @relation(fields: [userId], references: [id])
  template SideQuestTemplate? @relation(fields: [templateId], references: [id])
  runs     SideQuestRun[]
}

model SideQuestTemplate {
  id           String  @id @default(uuid())
  title        String  @unique
  description  String?
  difficulty   String
  durationDays Int
  icon         String?

  quests SideQuest[]
  tasks  SideQuestTaskTemplate[]
}

model SideQuestTaskTemplate {
  id           String   @id @default(uuid())
  templateId   String
  title        String
  description  String?
  icon         String?
  order        Int      @default(0)
  frequency    String   @default("daily")
  targetValue  Int?
  targetUnit   String?

  template SideQuestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks    SideQuestTask[]
}

model SideQuestRun {
  id          String    @id @default(uuid())
  sideQuestId String
  runNumber   Int
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  completed   Boolean   @default(false)

  sideQuest SideQuest       @relation(fields: [sideQuestId], references: [id], onDelete: Cascade)
  tasks     SideQuestTask[]

  @@unique([sideQuestId, runNumber])
  @@index([sideQuestId, completed])
}

model SideQuestTask {
  id                 String    @id @default(uuid())
  runId              String
  templateTaskId     String?
  title              String
  description        String?
  icon               String?
  order              Int       @default(0)
  frequency          String    @default("daily")
  targetValue        Int?
  targetUnit         String?
  completed          Boolean   @default(false)
  completedAt        DateTime?

  run          SideQuestRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  templateTask SideQuestTaskTemplate? @relation(fields: [templateTaskId], references: [id], onDelete: SetNull)
  logs         SideQuestTaskLog[]

  @@index([runId, order])
}

model SideQuestTaskLog {
  id          String   @id @default(uuid())
  taskId      String
  periodKey   String
  value       Int      @default(1)
  completedAt DateTime @default(now())

  task SideQuestTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, periodKey])
  @@index([taskId])
}

model Achievement {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String
  icon        String
  color       String
  unlocked    Boolean   @default(false)
  unlockedAt  DateTime?
  progress    Int       @default(0)
  total       Int

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, title]) // Ensure users don't have duplicate achievements of the same type
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  passwordHash        String
  age                 Int?
  weight              Float?
  targetWeight        Float?
  height              Float?
  registeredAt        DateTime @default(now())
  onboardingCompleted Boolean  @default(false)

  challenges   Challenge[]
  sideQuests   SideQuest[]
  achievements Achievement[]
}

model Challenge {
  id                  String   @id @default(uuid())
  userId              String
  isActive            Boolean  @default(true)
  difficulty          String
  startDate           DateTime @default(now())
  currentDay          Int      @default(1)
  streak              Int      @default(0)
  points              Int      @default(0)
  bestWeight          Float?
  challengesCompleted Int      @default(0)

  user                User           @relation(fields: [userId], references: [id])
  customGoalsTemplate GoalTemplate[]
  dailyLogs           DailyLog[]
}

model GoalTemplate {
  id          String  @id @default(uuid())
  challengeId String
  title       String
  description String?
  icon        String?

  challenge Challenge @relation(fields: [challengeId], references: [id])
}

model DailyLog {
  id          String  @id @default(uuid())
  challengeId String
  date        String // YYYY-MM-DD format
  weight      Float?
  photoUrl    String?
  notes       String?
  status      String  @default("pending") // pending, success, fail, rest

  challenge Challenge   @relation(fields: [challengeId], references: [id])
  goals     DailyGoal[]

  @@unique([challengeId, date])
}

model DailyGoal {
  id          String  @id @default(uuid())
  dailyLogId  String
  title       String
  description String?
  icon        String?
  completed   Boolean @default(false)

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id])
}

model SideQuest {
  id           String   @id @default(uuid())
  userId       String
  title        String
  difficulty   String
  durationDays Int
  startedAt    DateTime @default(now())
  progress     Int      @default(0)
  completed    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])
}

model SideQuestTemplate {
  id           String  @id @default(uuid())
  title        String  @unique
  description  String?
  difficulty   String
  durationDays Int
  icon         String?
}

model Achievement {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String
  icon        String
  color       String
  unlocked    Boolean   @default(false)
  unlockedAt  DateTime?
  progress    Int       @default(0)
  total       Int

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, title]) // Ensure users don't have duplicate achievements of the same type
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  age          Int?
  weight       Float?
  height       Float?
  registeredAt DateTime  @default(now())
  
  challenges   Challenge[]
  sideQuests   SideQuest[]
}

model Challenge {
  id                  String    @id @default(uuid())
  userId              String
  isActive            Boolean   @default(true)
  difficulty          String
  startDate           DateTime  @default(now())
  currentDay          Int       @default(1)
  streak              Int       @default(0)
  points              Int       @default(0)
  bestWeight          Float?
  challengesCompleted Int       @default(0)

  user                User      @relation(fields: [userId], references: [id])
  customGoalsTemplate GoalTemplate[]
  dailyLogs           DailyLog[]
}

model GoalTemplate {
  id          String    @id @default(uuid())
  challengeId String
  title       String
  description String?
  icon        String?

  challenge   Challenge @relation(fields: [challengeId], references: [id])
}

model DailyLog {
  id          String    @id @default(uuid())
  challengeId String
  date        String    // YYYY-MM-DD format
  weight      Float?
  photoUrl    String?
  notes       String?
  status      String    @default("pending") // pending, success, fail, rest

  challenge   Challenge @relation(fields: [challengeId], references: [id])
  goals       DailyGoal[]

  @@unique([challengeId, date])
}

model DailyGoal {
  id          String    @id @default(uuid())
  dailyLogId  String
  title       String
  description String?
  icon        String?
  completed   Boolean   @default(false)

  dailyLog    DailyLog  @relation(fields: [dailyLogId], references: [id])
}

model SideQuest {
  id           String    @id @default(uuid())
  userId       String
  title        String
  difficulty   String
  durationDays Int
  startedAt    DateTime  @default(now())
  progress     Int       @default(0)
  completed    Boolean   @default(false)

  user         User      @relation(fields: [userId], references: [id])
}
